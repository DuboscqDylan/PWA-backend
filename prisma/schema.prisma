generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Song {
  id          Int        @id @default(autoincrement())
  name        String
  genre       String
  cover       String
  album       String
  artistId    Int
  duration    Int
  plays       Int
  rating      Float
  releaseDate DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  favorites   Favorite[]
  artist      Artist     @relation(fields: [artistId], references: [id])
}

model Artist {
  id         Int    @id @default(autoincrement())
  name       String @unique
  artistSlug String @unique
  songs      Song[]
}

model Favorite {
  id     Int  @id @default(autoincrement())
  songId Int  @unique
  song   Song @relation(fields: [songId], references: [id])
}
